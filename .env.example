# Core Configuration
APP_ENV=production
APP_PORT=8001
APP_HOST=127.0.0.1
WEBHOOK_SECRET=your_super_secret_webhook_salt_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=
TELEGRAM_PROXY=

# VK Callback API
VK_GROUP_TOKEN=your_vk_group_token
VK_CONFIRMATION_CODE=your_vk_code
VK_SECRET_KEY=your_vk_secret

# WhatsApp (Green-API)
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_green_api_token

# Viber
VIBER_AUTH_TOKEN=your_viber_auth_token
VIBER_SENDER_NAME="HoReCa Order Co-Pilot"

# MAX Corporate Messenger
MAX_BOT_TOKEN=your_max_bot_token
MAX_API_BASE_URL=https://platform-api2.max.ru

# Yandex Cloud (152-FZ)
YANDEX_API_KEY=your_yandex_api_key
YANDEX_FOLDER_ID=your_yandex_folder_id

# Database & Redis
DATABASE_URL=sqlite+aiosqlite:///./orders_enterprise.db
# Для Docker / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://copilot:copilot_pass@db:5432/orders_enterprise
REDIS_URL=redis://127.0.0.1:6379/0

# 1C Integration
USE_MOCK_1C=true
MOCK_1C_URL=http://127.0.0.1:8080/api/v1/mock-1c/orders
ONEC_URL=http://127.0.0.1:8080/api/v1/mock-1c/orders
ONEC_USER=
ONEC_PASSWORD=
ONEC_TIMEOUT_SEC=5.0

# Bitrix24 Integration
BITRIX_WEBHOOK_URL=
BITRIX_TIMEOUT_SEC=5.0

# Feature Flags & Polling
ENABLE_POLLING_BRIDGES=false
CHECK_PACK_MULTIPLES=true
SUGGEST_OUT_OF_STOCK_ANALOGS=true
CONFIDENCE_THRESHOLD=0.85
LOCK_TIMEOUT_SEC=60
OUTBOX_POLL_INTERVAL_SEC=60
